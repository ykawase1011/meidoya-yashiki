    "@meidoya-yashiki/node-provisioner": "workspace:*",
    "@meidoya-yashiki/provider-lima": "workspace:*",
    "@meidoya-yashiki/provider-native": "workspace:*",
    "@meidoya-yashiki/receipts": "workspace:*",
    "@meidoya-yashiki/recovery": "workspace:*",
    "@meidoya-yashiki/store-sqlite": "workspace:*",
    "@meidoya-yashiki/yashiki-core": "workspace:*"
