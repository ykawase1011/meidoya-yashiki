{
  "name": "@meidoya-yashiki/doctor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Preflight and health checks for provisioned nodes.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@meidoya-yashiki/credentials": "workspace:*",
    "@meidoya-yashiki/node-bundle": "workspace:*",
    "@meidoya-yashiki/node-protocol-client": "workspace:*",
    "@meidoya-yashiki/yashiki-core": "workspace:*"
  }
}
